generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// Infrastructure metadata only. User/vehicle/domain models belong to later issues.
model ServiceMetadata {
  key       String   @id @db.VarChar(64)
  value     String   @db.VarChar(256)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)
}

enum UserRole {
  USER
  ADMIN
}

enum SessionKind {
  WEB
  VEHICLE
}

enum PairingStatus {
  PENDING
  APPROVED
  CONSUMED
  CANCELLED
}

model User {
  id            String @id @default(uuid()) @db.Uuid
  role          UserRole @default(USER)
  rankingPublic Boolean @default(false)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  identities    AuthIdentity[]
  sessions      AuthSession[]
  installations Installation[]
  approvals     VehiclePairing[]
  vehicleSessions VehicleSession[]
}

model AuthIdentity {
  id       String @id @default(uuid()) @db.Uuid
  provider String @db.VarChar(32)
  subject  String @db.VarChar(128)
  userId   String @db.Uuid
  user     User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@unique([provider, subject])
}

model Installation {
  id             String @id @default(uuid()) @db.Uuid
  secretHash     String @db.Char(64)
  linkedUserId   String? @db.Uuid
  linkedUser     User? @relation(fields: [linkedUserId], references: [id], onDelete: Restrict)
  linkRevokedAt  DateTime? @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  pairings       VehiclePairing[]
  sessions       AuthSession[]
  vehicleSessions VehicleSession[]
  @@index([linkedUserId])
}

model AuthSession {
  id               String @id @default(uuid()) @db.Uuid
  userId           String @db.Uuid
  user             User @relation(fields: [userId], references: [id], onDelete: Restrict)
  provider         String @db.VarChar(32)
  kind             SessionKind
  installationId   String? @db.Uuid
  installation     Installation? @relation(fields: [installationId], references: [id], onDelete: Restrict)
  accessHash       String @unique @db.Char(64)
  accessExpiresAt  DateTime @db.Timestamptz(3)
  refreshExpiresAt DateTime @db.Timestamptz(3)
  revokedAt        DateTime? @db.Timestamptz(3)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  refreshes        RefreshCredential[]
  vehicleSessions  VehicleSession[]
  lotMutations     LotMutation[]
  @@index([userId])
  @@index([installationId])
}

model RefreshCredential {
  hash      String @id @db.Char(64)
  sessionId String @db.Uuid
  session   AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([sessionId])
}

model VehiclePairing {
  id              String @id @default(uuid()) @db.Uuid
  installationId  String @db.Uuid
  installation    Installation @relation(fields: [installationId], references: [id], onDelete: Restrict)
  deviceCodeHash  String @unique @db.Char(64)
  userCodeHash    String @unique @db.Char(64)
  status          PairingStatus @default(PENDING)
  approvedById    String? @db.Uuid
  approvedBy      User? @relation(fields: [approvedById], references: [id], onDelete: Restrict)
  expiresAt       DateTime @db.Timestamptz(3)
  consumedAt      DateTime? @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  @@index([installationId])
}

model AuthRateBucket {
  key         String @id @db.Char(64)
  windowStart DateTime @db.Timestamptz(3)
  count       Int
}

enum VehicleSessionState {
  ACTIVE
  CLOSED
}

enum VehicleEventType {
  CAPABILITIES_REPORTED
  SESSION_CLOSED
}

enum EventDisposition {
  APPLIED
  STORED_OUT_OF_ORDER
}

enum ReportedSource {
  SYNTHETIC
  APP_REPORTED
}

model VehicleSession {
  id                    String @id @default(uuid()) @db.Uuid
  userId                String @db.Uuid
  user                  User @relation(fields: [userId], references: [id], onDelete: Restrict)
  installationId        String @db.Uuid
  installation          Installation @relation(fields: [installationId], references: [id], onDelete: Restrict)
  authSessionId         String @db.Uuid
  authSession           AuthSession @relation(fields: [authSessionId], references: [id], onDelete: Restrict)
  creationKey           String @db.VarChar(64)
  requestHash           String @db.Char(64)
  creationResponse      Json @db.JsonB
  contractVersion       String @db.VarChar(16)
  appVersion            String @db.VarChar(32)
  reportedSource        ReportedSource
  state                 VehicleSessionState @default(ACTIVE)
  capabilities          Json @db.JsonB
  lastAppliedSequence   Int @default(0)
  lastAppliedOccurredAt DateTime? @db.Timestamptz(3)
  createdAt             DateTime @default(now()) @db.Timestamptz(3)
  closedAt              DateTime? @db.Timestamptz(3)
  events                VehicleEvent[]
  @@unique([authSessionId, creationKey])
  @@index([userId, installationId])
}

model VehicleEvent {
  sessionId    String @db.Uuid
  session      VehicleSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  eventId      String @db.VarChar(64)
  sequence     Int
  type         VehicleEventType
  payload      Json @db.JsonB
  requestHash  String @db.Char(64)
  occurredAt   DateTime @db.Timestamptz(3)
  receivedAt   DateTime @db.Timestamptz(3)
  disposition  EventDisposition
  receipt      Json @db.JsonB
  @@id([sessionId, eventId])
  @@unique([sessionId, sequence])
}

// Stable identity; all editable information lives in immutable revision snapshots.
model ParkingLot {
  id             String @id @default(uuid()) @db.Uuid
  code           String @unique @db.VarChar(64)
  currentVersion Int
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  revisions      LotRevision[]
}

model LotRevision {
  lotId           String @db.Uuid
  lot             ParkingLot @relation(fields: [lotId], references: [id], onDelete: Restrict)
  version         Int
  name            String @db.VarChar(120)
  active          Boolean
  latitude        Float
  longitude       Float
  ownership       String @db.VarChar(16)
  parkingType     String @db.VarChar(16)
  partnered       Boolean
  builtYear       Int?
  source          String @db.VarChar(16)
  sourceUpdatedAt DateTime @db.Timestamptz(3)
  structureStatus String @db.VarChar(16)
  discountCodes   String[] @default([])
  challengeAllowed Boolean @default(false)
  snapshot        Json @db.JsonB
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  floors          LotFloor[]
  @@id([lotId, version])
  @@index([source, active, latitude, longitude])
  @@index([discountCodes], type: Gin)
}

model LotFloor {
  lotId   String @db.Uuid
  version Int
  id      String @db.VarChar(32)
  revision LotRevision @relation(fields: [lotId, version], references: [lotId, version], onDelete: Restrict)
  zones   LotZone[]
  entrances LotEntrance[]
  rampsFrom LotRamp[] @relation("RampFromFloor")
  rampsTo   LotRamp[] @relation("RampToFloor")
  @@id([lotId, version, id])
}

model LotZone {
  lotId   String @db.Uuid
  version Int
  floorId String @db.VarChar(32)
  id      String @db.VarChar(32)
  floor   LotFloor @relation(fields: [lotId, version, floorId], references: [lotId, version, id], onDelete: Restrict)
  entrances LotEntrance[]
  rampsFrom LotRamp[] @relation("RampFromZone")
  rampsTo   LotRamp[] @relation("RampToZone")
  parkingSpaces ParkingSpace[]
  pillars LotPillar[]
  driveAisles LotDriveAisle[]
  @@id([lotId, version, id])
  @@unique([lotId, version, floorId, id])
}

model LotEntrance {
  lotId   String @db.Uuid
  version Int
  id      String @db.VarChar(32)
  floorId String @db.VarChar(32)
  zoneId  String? @db.VarChar(32)
  floor   LotFloor @relation(fields: [lotId, version, floorId], references: [lotId, version, id], onDelete: Restrict)
  zone    LotZone? @relation(fields: [lotId, version, floorId, zoneId], references: [lotId, version, floorId, id], onDelete: Restrict)
  @@id([lotId, version, id])
}

model LotRamp {
  lotId       String @db.Uuid
  version     Int
  id          String @db.VarChar(32)
  fromFloorId String @db.VarChar(32)
  toFloorId   String @db.VarChar(32)
  fromZoneId  String? @db.VarChar(32)
  toZoneId    String? @db.VarChar(32)
  fromFloor LotFloor @relation("RampFromFloor", fields: [lotId, version, fromFloorId], references: [lotId, version, id], onDelete: Restrict)
  toFloor   LotFloor @relation("RampToFloor", fields: [lotId, version, toFloorId], references: [lotId, version, id], onDelete: Restrict)
  fromZone LotZone? @relation("RampFromZone", fields: [lotId, version, fromFloorId, fromZoneId], references: [lotId, version, floorId, id], onDelete: Restrict)
  toZone   LotZone? @relation("RampToZone", fields: [lotId, version, toFloorId, toZoneId], references: [lotId, version, floorId, id], onDelete: Restrict)
  @@id([lotId, version, id])
}

model LotMutation {
  authSessionId String @db.Uuid
  authSession AuthSession @relation(fields: [authSessionId], references: [id], onDelete: Restrict)
  key         String @db.VarChar(64)
  requestHash String @db.Char(64)
  response    Json @db.JsonB
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  @@id([authSessionId, key])
}

model ParkingSpace {
  lotId   String @db.Uuid
  version Int
  id      String @db.VarChar(32)
  floorId String @db.VarChar(32)
  zoneId  String @db.VarChar(32)
  label   String @db.VarChar(32)
  type    String @db.VarChar(16)
  active  Boolean
  aisleId String? @db.VarChar(32)
  zone LotZone @relation(fields: [lotId, version, floorId, zoneId], references: [lotId, version, floorId, id], onDelete: Restrict)
  aisle LotDriveAisle? @relation(fields: [lotId, version, floorId, zoneId, aisleId], references: [lotId, version, floorId, zoneId, id], onDelete: Restrict)
  @@id([lotId, version, id])
  @@unique([lotId, version, floorId, label])
  @@unique([lotId, version, floorId, zoneId, id])
}

model LotPillar {
  lotId   String @db.Uuid
  version Int
  id      String @db.VarChar(32)
  floorId String @db.VarChar(32)
  zoneId  String @db.VarChar(32)
  zone LotZone @relation(fields: [lotId, version, floorId, zoneId], references: [lotId, version, floorId, id], onDelete: Restrict)
  @@id([lotId, version, id])
}

model LotDriveAisle {
  lotId String @db.Uuid
  version Int
  id String @db.VarChar(32)
  floorId String @db.VarChar(32)
  zoneId String @db.VarChar(32)
  zone LotZone @relation(fields: [lotId, version, floorId, zoneId], references: [lotId, version, floorId, id], onDelete: Restrict)
  spaces ParkingSpace[]
  @@id([lotId, version, id])
  @@unique([lotId, version, floorId, zoneId, id])
}
