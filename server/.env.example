# Local development only: replace these examples before using shared/production systems.
NODE_ENV=development
PORT=3000
POSTGRES_USER=parksical
POSTGRES_PASSWORD=replace-local-password
POSTGRES_DB=parksical_dev
DATABASE_URL=postgresql://parksical:replace-local-password@127.0.0.1:5432/parksical_dev
COMPOSE_DATABASE_URL=postgresql://parksical:replace-local-password@db:5432/parksical_dev
# Separate disposable database; never point tests at the application database.
TEST_DATABASE_URL=postgresql://parksical:replace-local-password@127.0.0.1:5432/parksical_test
# Optional HOST development only; never enable in production/Compose's production API.
# DEV_AUTH_ENABLED=true
# DEV_AUTH_SECRET=<generate-a-random-local-key-of-at-least-32-characters>

# Synthetic reviews require development auth; real reviews remain policy-disabled.
DEV_REVIEWS_ENABLED=false
REAL_REVIEWS_ENABLED=false

# Opt-in synthetic private locations/photos, non-production development authentication only.
DEV_LOCATIONS_ENABLED=false
REAL_LOCATIONS_ENABLED=false

# QR is non-production synthetic development only; enable alongside DEV_AUTH/DEV_LOCATIONS.
DEV_QR_ENABLED=false
REAL_QR_ENABLED=false
# Exact origin, HTTPS or loopback HTTP only; no trailing slash/path/query.
# QR_PUBLIC_ORIGIN=http://127.0.0.1:3000

# Synthetic mission/run validation only; requires non-production development authentication.
DEV_MISSIONS_ENABLED=false
REAL_MISSIONS_ENABLED=false

# S-14 synthetic reservations and explicit sandbox events only; non-production development auth required.
DEV_RESERVATIONS_ENABLED=false
REAL_RESERVATIONS_ENABLED=false

# S-15 synthetic rankings/public opt-in only; requires non-production development auth.
DEV_RANKINGS_ENABLED=false
REAL_RANKINGS_ENABLED=false

# S-16 synthetic prepayments. Disabled by default, forbidden in production.
DEV_PAYMENTS_ENABLED=false
REAL_PAYMENTS_ENABLED=false
# Enable with development auth and a separate locally generated secret (never commit it).
# PAYMENT_PROVIDER=SANDBOX
# PAYMENT_WEBHOOK_SECRET=<generate-a-random-local-secret-of-at-least-32-characters>

# S-17 synthetic MAX subscriptions, requires DEV_AUTH + DEV_PAYMENTS and sandbox provider.
DEV_SUBSCRIPTIONS_ENABLED=false
REAL_SUBSCRIPTIONS_ENABLED=false

# S-18 synthetic settlement/coupons; requires DEV_AUTH/RANKINGS/SUBSCRIPTIONS/PAYMENTS.
DEV_REWARDS_ENABLED=false
REAL_REWARDS_ENABLED=false
REAL_COUPONS_ENABLED=false
REAL_NOTIFICATIONS_ENABLED=false
# REWARD_NOTIFICATION_PROVIDER=SANDBOX
