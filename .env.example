# Local development only: replace these examples before using shared/production systems.
NODE_ENV=development
PORT=3000
POSTGRES_USER=parksical
POSTGRES_PASSWORD=replace-local-password
POSTGRES_DB=parksical_dev
DATABASE_URL=postgresql://parksical:replace-local-password@127.0.0.1:5432/parksical_dev
COMPOSE_DATABASE_URL=postgresql://parksical:replace-local-password@db:5432/parksical_dev
# Separate disposable database; never point tests at the application database.
TEST_DATABASE_URL=postgresql://parksical:replace-local-password@127.0.0.1:5432/parksical_test
# Optional HOST development only; never enable in production/Compose's production API.
# DEV_AUTH_ENABLED=true
# DEV_AUTH_SECRET=<generate-a-random-local-key-of-at-least-32-characters>
