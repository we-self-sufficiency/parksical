{
  "name": "parksical-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src test prisma.config.ts",
    "start": "node dist/main.js",
    "start:dev": "node --env-file=.env --watch dist/main.js",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "seed:synthetic": "node dist/lots/seed.js",
    "test": "tsc -p tsconfig.test.json && node --test test-build/test/unit/*.test.js",
    "test:integration": "tsc -p tsconfig.test.json && node test-build/test/run-db-tests.js",
    "verify": "npm run generate && npm run lint && npm run typecheck && npm test && npm run build",
    "seed:review-visit": "node dist/reviews/visit-seed.js"
  },
  "dependencies": {
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-express": "12.5.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "12.5.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "eslint": "10.14.0",
    "prisma": "7.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
